# Committed defaults. run-sample.sh sources this file, then overlays gitignored .env.
# Copy to .env. Local Observer uses localhost:4318 (no token). Splunk Cloud needs SPLUNK_ACCESS_TOKEN.
# In deployment, set the same names as system environment variables; the app does not read these files.

SPLUNK_ACCESS_TOKEN=

OTEL_SERVICE_NAME=sample-app
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=demo

OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
OTEL_LOGS_EXPORTER=none
# Splunk Cloud (instead of the localhost endpoints above):
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://ingest.us1.observability.splunkcloud.com/v2/trace/otlp
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://ingest.us1.observability.splunkcloud.com/v2/datapoint/otlp

# Extractor JSON for the sample app (Class:method list). Required for any other app too.
INSTRUMENTATION_CONFIG=java-extension/src/main/resources/instlocal.json

# Splunk no-code YAML (requires Splunk OTel Java agent). Compare nc.* attrs vs JSON extracts.
SPLUNK_OTEL_INSTRUMENTATION_NOCODE_YML_FILE=java-extension/src/main/resources/nocode.yml

# JVM flags picked up automatically by the HotSpot VM (not the application).
# Needed only when running Spring Boot 2.0.x on JDK 16+. Omit on Java 8/11.
JAVA_TOOL_OPTIONS="--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED"

# Vanilla OpenTelemetry Java agent sends the Splunk token as an OTLP header.
# After SPLUNK_ACCESS_TOKEN is set, either export this yourself or let run-sample.sh set it.
# OTEL_EXPORTER_OTLP_HEADERS=X-SF-TOKEN=
