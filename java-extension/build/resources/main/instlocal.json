{
  "version": 1,
  "instrumentations": [
    {
      "id": "sum",
      "class": "com.mulabs.java.WebFrontEndController",
      "onMethod": "sum",
      "return": [
        {
          "attribute": "sum.result",
          "createMetric": true
        }
      ]
    },
    {
      "id": "pay",
      "class": "com.mulabs.java.WebFrontEndController",
      "onMethod": "pay",
      "args": [
        {
          "attribute": "customer",
          "index": 0,
          "addTagToMetric": true
        },
        {
          "attribute": "amount",
          "index": 1,
          "createMetric": true
        }
      ],
      "instance": [
        {
          "attribute": "store.name",
          "call": "getName",
          "addTagToMetric": true
        }
      ]
    },
    {
      "id": "store",
      "class": "com.mulabs.java.WebFrontEndController",
      "instance": [
        {
          "attribute": "class.var",
          "field": "classVar"
        }
      ]
    }
  ]
}
